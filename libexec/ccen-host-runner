#!/usr/bin/env python3
"""Socket-activated broker for tightly predefined host jobs.

The broker never accepts an argv, cwd, environment variable, or shell snippet
from the client.  Clients may only name a profile that already exists in the
private host policy.  Each accepted job becomes an independent transient user
service, so losing Claude, VS Code, SSH, or this broker does not stop the job.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import traceback
import uuid
from pathlib import Path
from typing import Any


MAX_REQUEST = 64 * 1024
MAX_POLICY = 256 * 1024
MAX_LOG_CHUNK = 256 * 1024
PROFILE_RE = re.compile(r"[a-z][a-z0-9-]{0,47}")
JOB_RE = re.compile(r"job-[0-9a-f]{32}")
REQUEST_RE = re.compile(r"[A-Za-z0-9._:@+-]{1,128}")
ENV_RE = re.compile(r"[A-Z_][A-Z0-9_]{0,63}")
DENIED_ENV = {
    "ALL_PROXY",
    "BASH_ENV",
    "DBUS_SESSION_BUS_ADDRESS",
    "DBUS_SYSTEM_BUS_ADDRESS",
    "DISPLAY",
    "ENV",
    "GIT_ASKPASS",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "HOME",
    "LANG",
    "LANGUAGE",
    "LC_ALL",
    "LD_PRELOAD",
    "LOGNAME",
    "LOCPATH",
    "NO_PROXY",
    "NODE_OPTIONS",
    "PYTHONHOME",
    "PYTHONPATH",
    "SSH_AUTH_SOCK",
    "TCLLIBPATH",
    "TZ",
    "USER",
    "WAYLAND_DISPLAY",
}
DENIED_ENV_PREFIXES = ("ANTHROPIC_", "CCEN_", "CLAUDE_")


class RequestError(RuntimeError):
    """A client-visible validation or operation failure."""


def utc_timestamp() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        raise


def sha256_file(path: Path) -> str:
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    digest = hashlib.sha256()
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise RequestError(f"not a regular file: {path}")
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
    finally:
        os.close(descriptor)
    return digest.hexdigest()


def private_regular_file(path: Path, description: str) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise RequestError(f"{description} is unavailable") from error
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
        raise RequestError(f"{description} has an unsafe owner or type")
    if stat.S_IMODE(metadata.st_mode) & 0o077:
        raise RequestError(f"{description} must not be accessible by group/others")
    return metadata


def read_json(path: Path, limit: int, description: str) -> Any:
    private_regular_file(path, description)
    try:
        payload = path.read_bytes()
    except OSError as error:
        raise RequestError(f"cannot read {description}") from error
    if len(payload) > limit:
        raise RequestError(f"{description} is too large")
    try:
        return json.loads(payload)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RequestError(f"{description} is not valid JSON") from error


def ensure_private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    metadata = path.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) & 0o077
    ):
        raise RuntimeError(f"unsafe state directory: {path}")


def validate_profile(name: str, raw: Any) -> dict[str, Any]:
    if not PROFILE_RE.fullmatch(name) or not isinstance(raw, dict):
        raise RequestError(f"invalid profile definition: {name!r}")
    allowed = {
        "description",
        "command",
        "working_directory",
        "timeout_seconds",
        "environment",
        "integrity",
        "network",
    }
    if set(raw) - allowed:
        raise RequestError(f"profile {name!r} contains unknown keys")
    command = raw.get("command")
    if (
        not isinstance(command, list)
        or not 1 <= len(command) <= 128
        or not all(
            isinstance(item, str) and item and "\0" not in item and len(item) <= 8192
            for item in command
        )
    ):
        raise RequestError(f"profile {name!r} has an invalid command vector")
    executable = Path(command[0])
    if not executable.is_absolute():
        raise RequestError(f"profile {name!r} executable must be absolute")
    try:
        resolved_executable = executable.resolve(strict=True)
        executable_metadata = resolved_executable.stat()
    except OSError as error:
        raise RequestError(f"profile {name!r} executable is unavailable") from error
    if (
        not stat.S_ISREG(executable_metadata.st_mode)
        or not os.access(resolved_executable, os.X_OK)
        or executable_metadata.st_uid != 0
        or stat.S_IMODE(executable_metadata.st_mode) & 0o022
    ):
        raise RequestError(f"profile {name!r} executable is not executable")
    command = [str(resolved_executable), *command[1:]]

    working_directory = raw.get("working_directory")
    if not isinstance(working_directory, str) or not Path(working_directory).is_absolute():
        raise RequestError(f"profile {name!r} working_directory must be absolute")
    try:
        resolved_working_directory = Path(working_directory).resolve(strict=True)
    except OSError as error:
        raise RequestError(f"profile {name!r} working_directory is unavailable") from error
    if not resolved_working_directory.is_dir():
        raise RequestError(f"profile {name!r} working_directory is not a directory")

    timeout = raw.get("timeout_seconds")
    if not isinstance(timeout, int) or not 1 <= timeout <= 7 * 24 * 60 * 60:
        raise RequestError(f"profile {name!r} timeout_seconds is invalid")
    if raw.get("network") != "offline":
        raise RequestError(f"profile {name!r} must use the offline network policy")

    environment = raw.get("environment", {})
    if not isinstance(environment, dict) or len(environment) > 64:
        raise RequestError(f"profile {name!r} environment is invalid")
    clean_environment: dict[str, str] = {}
    for key, value in environment.items():
        if (
            not isinstance(key, str)
            or not ENV_RE.fullmatch(key)
            or not isinstance(value, str)
            or "\0" in value
            or len(value) > 4096
            or key in DENIED_ENV
            or key.lower() in {item.lower() for item in DENIED_ENV}
            or key.startswith(DENIED_ENV_PREFIXES)
        ):
            raise RequestError(f"profile {name!r} contains a forbidden environment key")
        clean_environment[key] = value

    integrity = raw.get("integrity", {})
    if not isinstance(integrity, dict) or len(integrity) > 64:
        raise RequestError(f"profile {name!r} integrity map is invalid")
    clean_integrity: dict[str, str] = {}
    for filename, digest in integrity.items():
        if (
            not isinstance(filename, str)
            or not Path(filename).is_absolute()
            or not isinstance(digest, str)
            or not re.fullmatch(r"[0-9a-f]{64}", digest)
        ):
            raise RequestError(f"profile {name!r} integrity entry is invalid")
        clean_integrity[filename] = digest

    return {
        "description": str(raw.get("description", ""))[:512],
        "command": command,
        "working_directory": str(resolved_working_directory),
        "timeout_seconds": timeout,
        "environment": clean_environment,
        "integrity": clean_integrity,
        "network": "offline",
    }


def load_policy(path: Path) -> dict[str, dict[str, Any]]:
    raw = read_json(path, MAX_POLICY, "host runner policy")
    if not isinstance(raw, dict) or set(raw) != {"version", "profiles"}:
        raise RequestError("host runner policy has an invalid top-level schema")
    if raw.get("version") != 1 or not isinstance(raw.get("profiles"), dict):
        raise RequestError("host runner policy has an unsupported version")
    if len(raw["profiles"]) > 64:
        raise RequestError("host runner policy contains too many profiles")
    return {
        name: validate_profile(name, profile)
        for name, profile in raw["profiles"].items()
    }


def verify_integrity(profile: dict[str, Any]) -> None:
    for filename, expected in profile["integrity"].items():
        path = Path(filename)
        try:
            metadata = path.lstat()
        except OSError as error:
            raise RequestError(f"integrity path is unavailable: {filename}") from error
        if not stat.S_ISREG(metadata.st_mode):
            raise RequestError(f"integrity path is not a regular file: {filename}")
        digest = sha256_file(path)
        if digest != expected:
            raise RequestError(f"integrity check failed: {filename}")


class Broker:
    def __init__(
        self,
        policy_path: Path,
        state_root: Path,
        systemd_run: str,
        systemctl: str,
    ) -> None:
        self.policy_path = policy_path
        self.state_root = state_root
        self.jobs_root = state_root / "jobs"
        self.requests_root = state_root / "requests"
        self.systemd_run = systemd_run
        self.systemctl = systemctl
        self.lock = threading.RLock()
        ensure_private_directory(state_root)
        ensure_private_directory(self.jobs_root)
        ensure_private_directory(self.requests_root)

    def job_path(self, job_id: str) -> Path:
        if not isinstance(job_id, str) or not JOB_RE.fullmatch(job_id):
            raise RequestError("invalid job id")
        return self.jobs_root / job_id / "job.json"

    @staticmethod
    def unit_for_job(job_id: str) -> str:
        if not isinstance(job_id, str) or not JOB_RE.fullmatch(job_id):
            raise RequestError("invalid job id")
        return f"ccen-host-{job_id}.service"

    def log_path_for_job(self, job_id: str) -> Path:
        return self.job_path(job_id).parent / "output.log"

    def result_path_for_job(self, job_id: str) -> Path:
        return self.job_path(job_id).parent / "result.json"

    def load_job(self, job_id: str) -> dict[str, Any]:
        raw = read_json(self.job_path(job_id), MAX_POLICY, "job record")
        if not isinstance(raw, dict) or raw.get("job_id") != job_id:
            raise RequestError("job record is invalid")
        expected_unit = self.unit_for_job(job_id)
        expected_log = str(self.log_path_for_job(job_id))
        if raw.get("unit") not in {None, expected_unit}:
            raise RequestError("job record contains an invalid unit")
        if raw.get("log_path") not in {None, expected_log}:
            raise RequestError("job record contains an invalid log path")
        raw["unit"] = expected_unit
        raw["log_path"] = expected_log
        return raw

    def save_job(self, job: dict[str, Any]) -> None:
        atomic_json(self.job_path(job["job_id"]), job)

    def systemctl_show(self, unit: str) -> dict[str, str]:
        command = [
            self.systemctl,
            "--user",
            "show",
            unit,
            "--no-pager",
            "--property=LoadState,ActiveState,SubState,Result,ExecMainCode,ExecMainStatus,ControlGroup,ExecMainStartTimestamp,ExecMainExitTimestamp",
        ]
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
            check=False,
        )
        values: dict[str, str] = {}
        for line in completed.stdout.splitlines():
            key, separator, value = line.partition("=")
            if separator:
                values[key] = value
        values["_query_returncode"] = str(completed.returncode)
        return values

    def load_result(self, job_id: str) -> dict[str, Any] | None:
        result_path = self.result_path_for_job(job_id)
        if not result_path.exists():
            return None
        raw = read_json(result_path, MAX_POLICY, "job result")
        required = {
            "version",
            "job_id",
            "started_at",
            "finished_at",
            "returncode",
            "signal",
            "outcome",
            "error",
        }
        if (
            not isinstance(raw, dict)
            or not required.issubset(raw)
            or raw.get("version") != 1
            or raw.get("job_id") != job_id
            or not isinstance(raw.get("returncode"), int)
            or raw.get("outcome") not in {"succeeded", "failed", "shim-error"}
        ):
            raise RequestError("job result is invalid")
        return raw

    def refresh(self, job: dict[str, Any]) -> dict[str, Any]:
        job_id = job["job_id"]
        job["unit"] = self.unit_for_job(job_id)
        job["log_path"] = str(self.log_path_for_job(job_id))
        result = self.load_result(job_id)
        unit_state = self.systemctl_show(job["unit"])
        active = unit_state.get("ActiveState", "unknown")
        load_state = unit_state.get("LoadState", "unknown")
        if result is not None:
            if job.get("cancel_requested") and result["outcome"] != "succeeded":
                state = "cancelled"
            elif result["outcome"] == "succeeded" and result["returncode"] == 0:
                state = "succeeded"
            else:
                state = "failed"
            job["result"] = result
        elif job.get("state") == "failed-to-start":
            state = "failed-to-start"
        elif job.get("cancel_requested") and active in {"deactivating", "active"}:
            state = "stopping"
        elif load_state == "not-found" or unit_state.get("_query_returncode") != "0":
            deadline = job.get("deadline_epoch")
            if job.get("cancel_requested"):
                state = "cancelled"
            elif isinstance(deadline, (int, float)) and time.time() >= deadline:
                state = "timed-out"
            else:
                state = "interrupted"
        elif active in {"active", "activating", "reloading"}:
            state = "running"
        elif active == "failed":
            state = "timed-out" if unit_state.get("Result") == "timeout" else "failed"
        elif active == "inactive":
            if job.get("cancel_requested"):
                state = "cancelled"
            else:
                state = "interrupted"
        else:
            state = "queued"

        job["state"] = state
        job["unit_state"] = unit_state
        job["updated_at"] = utc_timestamp()
        self.save_job(job)
        return job

    def submit(self, request: dict[str, Any]) -> dict[str, Any]:
        if set(request) != {"op", "profile", "request_id"}:
            raise RequestError("submit request has unknown or missing fields")
        profile_name = request.get("profile")
        request_id = request.get("request_id")
        if not isinstance(profile_name, str) or not PROFILE_RE.fullmatch(profile_name):
            raise RequestError("invalid profile name")
        if not isinstance(request_id, str) or not REQUEST_RE.fullmatch(request_id):
            raise RequestError("invalid request id")

        request_key = hashlib.sha256(request_id.encode("utf-8")).hexdigest()
        request_path = self.requests_root / f"{request_key}.json"
        with self.lock:
            if request_path.exists():
                previous = read_json(request_path, MAX_POLICY, "request record")
                if not isinstance(previous, dict) or previous.get("request_id") != request_id:
                    raise RequestError("request record is invalid")
                if previous.get("profile") != profile_name:
                    raise RequestError("request id was already used for another profile")
                return {"ok": True, "deduplicated": True, "job": self.refresh(self.load_job(previous["job_id"]))}

        profiles = load_policy(self.policy_path)
        if profile_name not in profiles:
            raise RequestError("profile is not approved by the host policy")
        profile = profiles[profile_name]
        verify_integrity(profile)

        job_id = f"job-{uuid.uuid4().hex}"
        unit = self.unit_for_job(job_id)
        job_dir = self.jobs_root / job_id
        ensure_private_directory(job_dir)
        log_path = self.log_path_for_job(job_id)
        descriptor = os.open(log_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(descriptor)
        job: dict[str, Any] = {
            "job_id": job_id,
            "request_id": request_id,
            "profile": profile_name,
            "description": profile["description"],
            "unit": unit,
            "state": "queued",
            "created_at": utc_timestamp(),
            "created_epoch": time.time(),
            "deadline_epoch": time.time() + profile["timeout_seconds"] + 30,
            "updated_at": utc_timestamp(),
            "log_path": str(log_path),
            "network": "offline",
        }
        self.save_job(job)
        atomic_json(
            request_path,
            {"request_id": request_id, "profile": profile_name, "job_id": job_id},
        )

        locale_root = Path(os.path.expanduser("~/.local/lib/locale"))
        if not locale_root.is_dir():
            raise RequestError("Singapore locale directory is unavailable")
        base_environment = {
            "HOME": os.path.expanduser("~"),
            "LANG": "en_SG.UTF-8",
            "LANGUAGE": "en_SG:zh_SG",
            "LC_ALL": "en_SG.UTF-8",
            "LOGNAME": os.environ.get("LOGNAME", os.environ.get("USER", "")),
            "LOCPATH": str(locale_root),
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "TZ": "Asia/Singapore",
            "USER": os.environ.get("USER", ""),
        }
        base_environment.update(profile["environment"])
        env_argv = [f"{key}={value}" for key, value in sorted(base_environment.items())]

        launch = {
            "version": 1,
            "job_id": job_id,
            "command": profile["command"],
            "working_directory": profile["working_directory"],
            "environment": base_environment,
            "policy_path": str(self.policy_path),
            "state_root": str(self.state_root),
        }
        launch_path = job_dir / "launch.json"
        result_path = self.result_path_for_job(job_id)
        atomic_json(launch_path, launch)
        launch_hash = sha256_file(launch_path)

        worker_source = Path(__file__).resolve().with_name("ccen-host-job")
        try:
            worker_metadata = worker_source.lstat()
        except OSError as error:
            raise RequestError("host job shim is unavailable") from error
        if (
            not stat.S_ISREG(worker_metadata.st_mode)
            or worker_metadata.st_uid != os.getuid()
            or stat.S_IMODE(worker_metadata.st_mode) & 0o022
            or not os.access(worker_source, os.X_OK)
        ):
            raise RequestError("host job shim has unsafe metadata")
        worker_snapshot = job_dir / "ccen-host-job"
        shutil.copyfile(worker_source, worker_snapshot, follow_symlinks=False)
        os.chmod(worker_snapshot, 0o500)
        run_command = [
            self.systemd_run,
            "--user",
            "--quiet",
            f"--unit={unit}",
            "--service-type=exec",
            f"--working-directory={profile['working_directory']}",
            "--property=Description=CCEN approved host job",
            "--property=KillMode=mixed",
            "--property=SendSIGKILL=yes",
            "--property=TimeoutStopSec=15s",
            f"--property=RuntimeMaxSec={profile['timeout_seconds']}s",
            "--property=UMask=0077",
            "--property=NoNewPrivileges=yes",
            "--property=PrivateNetwork=no",
            "--property=PrivateTmp=yes",
            "--property=ProtectSystem=full",
            "--property=ProtectHome=no",
            "--property=RestrictAddressFamilies=AF_NETLINK",
            "--property=SystemCallArchitectures=native",
            f"--property=StandardOutput=append:{log_path}",
            f"--property=StandardError=append:{log_path}",
            "/usr/bin/env",
            "-i",
            *env_argv,
            str(worker_snapshot),
            str(launch_path),
            launch_hash,
            str(result_path),
        ]
        completed = subprocess.run(
            run_command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=20,
            check=False,
        )
        if completed.returncode != 0:
            job["state"] = "failed-to-start"
            job["start_error"] = completed.stderr.strip()[-4096:]
            job["updated_at"] = utc_timestamp()
            self.save_job(job)
            raise RequestError("host systemd rejected the job")
        return {"ok": True, "deduplicated": False, "job": self.refresh(job)}

    def status(self, request: dict[str, Any]) -> dict[str, Any]:
        if set(request) != {"op", "job_id"}:
            raise RequestError("status request has unknown or missing fields")
        return {"ok": True, "job": self.refresh(self.load_job(request.get("job_id")))}

    def list_jobs(self, request: dict[str, Any]) -> dict[str, Any]:
        if set(request) != {"op"}:
            raise RequestError("list request contains unknown fields")
        jobs: list[dict[str, Any]] = []
        for path in sorted(self.jobs_root.glob("job-*/job.json"), reverse=True)[:100]:
            job_id = path.parent.name
            if JOB_RE.fullmatch(job_id):
                try:
                    jobs.append(self.refresh(self.load_job(job_id)))
                except RequestError:
                    continue
        return {"ok": True, "jobs": jobs}

    def logs(self, request: dict[str, Any]) -> dict[str, Any]:
        if set(request) != {"op", "job_id", "offset", "limit"}:
            raise RequestError("logs request has unknown or missing fields")
        offset = request.get("offset")
        limit = request.get("limit")
        if (
            not isinstance(offset, int)
            or offset < 0
            or not isinstance(limit, int)
            or not 1 <= limit <= MAX_LOG_CHUNK
        ):
            raise RequestError("invalid log offset or limit")
        job = self.load_job(request.get("job_id"))
        log_path = self.log_path_for_job(job["job_id"])
        try:
            with log_path.open("rb") as stream:
                stream.seek(offset)
                data = stream.read(limit)
                next_offset = stream.tell()
                stream.seek(0, os.SEEK_END)
                size = stream.tell()
        except OSError as error:
            raise RequestError("job log is unavailable") from error
        return {
            "ok": True,
            "job_id": job["job_id"],
            "offset": offset,
            "next_offset": next_offset,
            "size": size,
            "eof": next_offset >= size,
            "data": data.decode("utf-8", errors="replace"),
        }

    def cancel(self, request: dict[str, Any]) -> dict[str, Any]:
        if set(request) != {"op", "job_id"}:
            raise RequestError("cancel request has unknown or missing fields")
        job = self.load_job(request.get("job_id"))
        completed = subprocess.run(
            [self.systemctl, "--user", "stop", self.unit_for_job(job["job_id"])],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30,
            check=False,
        )
        if completed.returncode != 0 and "not loaded" not in completed.stderr.lower():
            raise RequestError("systemd could not stop the job")
        job["cancel_requested"] = True
        job["updated_at"] = utc_timestamp()
        self.save_job(job)
        return {"ok": True, "job": self.refresh(job)}

    def dispatch(self, request: Any) -> dict[str, Any]:
        if not isinstance(request, dict) or not isinstance(request.get("op"), str):
            raise RequestError("request must be a JSON object with an operation")
        operation = request["op"]
        if operation == "submit":
            return self.submit(request)
        if operation == "status":
            return self.status(request)
        if operation == "list":
            return self.list_jobs(request)
        if operation == "logs":
            return self.logs(request)
        if operation == "cancel":
            return self.cancel(request)
        raise RequestError("unsupported operation")


def peer_uid(connection: socket.socket) -> int:
    credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
    _pid = int.from_bytes(credentials[0:4], sys.byteorder, signed=True)
    uid = int.from_bytes(credentials[4:8], sys.byteorder, signed=False)
    return uid


def read_request(connection: socket.socket) -> Any:
    connection.settimeout(5.0)
    buffer = bytearray()
    while b"\n" not in buffer:
        chunk = connection.recv(8192)
        if not chunk:
            break
        buffer.extend(chunk)
        if len(buffer) > MAX_REQUEST:
            raise RequestError("request is too large")
    line, separator, remainder = bytes(buffer).partition(b"\n")
    if not separator or remainder.strip():
        raise RequestError("request must contain exactly one JSON line")
    try:
        return json.loads(line)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RequestError("request is not valid JSON") from error


def inherited_listener() -> socket.socket:
    try:
        listen_pid = int(os.environ.get("LISTEN_PID", "0"))
        listen_fds = int(os.environ.get("LISTEN_FDS", "0"))
    except ValueError as error:
        raise RuntimeError("invalid systemd socket activation environment") from error
    if listen_pid != os.getpid() or listen_fds != 1:
        raise RuntimeError("exactly one systemd-activated socket is required")
    listener = socket.socket(fileno=3)
    listener.set_inheritable(False)
    return listener


def standalone_listener(path: Path) -> socket.socket:
    if not path.is_absolute():
        raise RuntimeError("standalone socket path must be absolute")
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        metadata = None
    if metadata is not None:
        if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise RuntimeError("refusing to replace a non-socket standalone path")
        path.unlink()
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(str(path))
    os.chmod(path, 0o600)
    listener.listen(64)
    return listener


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--policy",
        default=os.path.expanduser("~/.config/ccen/host-runner.json"),
    )
    parser.add_argument(
        "--state-dir",
        default=os.path.expanduser("~/.local/state/ccen/host-jobs"),
    )
    parser.add_argument("--socket", default=None, help="standalone test mode")
    parser.add_argument("--systemd-run", default="/usr/bin/systemd-run")
    parser.add_argument("--systemctl", default="/usr/bin/systemctl")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    policy_path = Path(args.policy)
    state_root = Path(args.state_dir)
    # Fail before accepting requests when the private policy is missing or bad.
    load_policy(policy_path)
    broker = Broker(policy_path, state_root, args.systemd_run, args.systemctl)
    listener = standalone_listener(Path(args.socket)) if args.socket else inherited_listener()
    listener.listen(64)

    while True:
        connection, _address = listener.accept()
        with connection:
            try:
                if peer_uid(connection) != os.getuid():
                    raise RequestError("peer uid is not authorized")
                response = broker.dispatch(read_request(connection))
            except RequestError as error:
                response = {"ok": False, "error": str(error)}
            except Exception:
                traceback.print_exc(file=sys.stderr)
                response = {"ok": False, "error": "internal host runner error"}
            encoded = json.dumps(response, ensure_ascii=False, separators=(",", ":")).encode("utf-8") + b"\n"
            try:
                connection.sendall(encoded)
            except OSError:
                pass


if __name__ == "__main__":
    raise SystemExit(main())
