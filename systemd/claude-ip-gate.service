[Unit]
Description=Claude Code fail-closed fixed-IP proxy gate
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I __CCEN_HOME__/.local/libexec/claude-ip-gate
Restart=always
RestartSec=2s
KillMode=control-group
TimeoutStopSec=5s
RuntimeDirectory=claude-ip-gate
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Environment=HOME=__CCEN_HOME__
Environment=XDG_RUNTIME_DIR=/run/user/__CCEN_UID__
Environment=XDG_STATE_HOME=__CCEN_HOME__/.local/state
Environment=LOCPATH=__CCEN_HOME__/.local/lib/locale
Environment=TZ=Asia/Singapore
Environment=LANG=en_SG.UTF-8
Environment=LC_ALL=en_SG.UTF-8
Environment=LANGUAGE=en_SG:zh_SG
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
