[Unit]
Description=Claude Code fixed SSH relay to %i (socket in the fpga04 relay dir)
After=default.target claude-fpga04-ssh-relay.service
Wants=claude-fpga04-ssh-relay.service
ConditionHost=__CCEN_LAB_HOSTNAME__

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I __CCEN_HOME__/.local/libexec/claude-lab-ssh-relay %i
Restart=always
RestartSec=2s
KillMode=control-group
TimeoutStopSec=5s
ReadWritePaths=/run/user/__CCEN_UID__/claude-fpga04-ssh-relay
UMask=0077
Environment=HOME=__CCEN_HOME__
Environment=XDG_RUNTIME_DIR=/run/user/__CCEN_UID__
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target
